# Kyuhachi iOS delivery: build the app and upload it to TestFlight (internal).
#
# This runs on a GitHub Actions macOS runner (see .github/workflows/deploy.yml
# for production deploys and .github/workflows/preview-build.yml for PR previews),
# NOT in Expo's cloud. The native `ios/` project is regenerated by `expo
# prebuild` on every run and is gitignored, so every path below is relative to
# the freshly prebuilt project and nothing here is committed.
#
# Two lanes, one shared body:
#   beta    production deploy (push to master). No changelog.
#   preview PR preview (label-triggered). Tags the TestFlight build with the
#             PR via ENV["PREVIEW_CHANGELOG"] so previews are distinguishable
#             from production builds in the same app.
# Both upload to the SAME app's TestFlight internal testers: no staging split,
# no App Store submission.
#
# Credentials arrive as files the workflow writes from base64 GitHub secrets
# (the same pattern the repo already uses for GoogleService-Info):
#   ENV["IOS_DIST_CERT_P12_PATH"]   Apple Distribution certificate (.p12)
#   ENV["IOS_CERTIFICATE_PASSWORD"] the .p12 export password
#   ENV["ASC_API_KEY_PATH"]         App Store Connect API key JSON
#                                   ({ key_id, issuer_id, key, in_house })

require "securerandom"

APP_ID     = "com.kyuhachi.app".freeze
TEAM_ID    = "L357YP9W28".freeze
WORKSPACE  = "ios/Kyuhachi.xcworkspace".freeze
XCODEPROJ  = "ios/Kyuhachi.xcodeproj".freeze
SCHEME     = "Kyuhachi".freeze
INFO_PLIST = "ios/Kyuhachi/Info.plist".freeze
IPA_NAME   = "Kyuhachi.ipa".freeze
# Fixed name for the App Store provisioning profile we generate, so we don't
# have to guess fastlane's generated-profile env-var key.
PROFILE_NAME = "Kyuhachi App Store".freeze

# Shared build + upload flow for both lanes. `changelog` is the TestFlight
# "What to Test" note: nil for production (`beta`), the PR marker for `preview`.
# Top-level def so both lanes call the exact same body. Fastlane actions are
# available here (same as upload_to_testflight_with_retry below).
def build_and_upload(changelog: nil)
  asc_api_key_path = ENV.fetch("ASC_API_KEY_PATH")

  keychain_name     = "kyuhachi-build.keychain"
  keychain_password = SecureRandom.base64

  create_keychain(
    name: keychain_name,
    password: keychain_password,
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    add_to_search_list: true,
  )

  begin
    import_certificate(
      certificate_path: ENV.fetch("IOS_DIST_CERT_P12_PATH"),
      certificate_password: ENV.fetch("IOS_CERTIFICATE_PASSWORD"),
      keychain_name: keychain_name,
      keychain_password: keychain_password,
    )

    # Generate/download a fresh App Store provisioning profile from the ASC
    # API key, so no long-lived .mobileprovision to store or renew. Requires the
    # key to have App Manager (or Admin) role. If the key is Developer-only,
    # store the profile as a base64 secret instead and replace this block with:
    #   install_provisioning_profile(path: ENV.fetch("IOS_PROFILE_PATH"))
    #   profile_name = "<the profile's name>"
    get_provisioning_profile(
      api_key_path: asc_api_key_path,
      app_identifier: APP_ID,
      provisioning_name: PROFILE_NAME,
      force: true,
    )

    # Build number from TestFlight, scoped to the current marketing version.
    # Expo SDK 55 writes CFBundleVersion as a literal in Info.plist (not a
    # $(CURRENT_PROJECT_VERSION) reference), so we set it directly there, and that
    # literal is what ends up in the .ipa. A failed/non-uploading run leaves the
    # TestFlight max unchanged, so the next run reuses latest+1: no drift.
    version = get_info_plist_value(path: INFO_PLIST, key: "CFBundleShortVersionString")
    latest = latest_testflight_build_number(
      api_key_path: asc_api_key_path,
      app_identifier: APP_ID,
      version: version,
      initial_build_number: 0,
    )
    build_number = latest.to_i + 1
    set_info_plist_value(path: INFO_PLIST, key: "CFBundleVersion", value: build_number.to_s)

    # Surface the chosen build number to the GitHub Actions workflow (for the PR
    # preview comment). No-op outside Actions.
    github_output = ENV["GITHUB_OUTPUT"]
    File.write(github_output, "build_number=#{build_number}\n", mode: "a") if github_output && !github_output.empty?

    # Pin manual signing to the generated profile so the archive is
    # deterministic on a fresh runner (Expo prebuild defaults to automatic).
    # Scoped to the app target so it can't touch other targets' settings.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODEPROJ,
      targets: [SCHEME],
      team_id: TEAM_ID,
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
    )

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      output_name: IPA_NAME,
      export_method: "app-store",
      export_options: {
        provisioningProfiles: { APP_ID => PROFILE_NAME },
        manageAppVersionAndBuildNumber: false,
      },
      xcargs: "-allowProvisioningUpdates",
    )

    upload_to_testflight_with_retry(asc_api_key_path, changelog: changelog)
  ensure
    keychain_db = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    delete_keychain(name: keychain_name) if File.exist?(keychain_db)
  end
end

# App Store Connect's TestFlight ingestion intermittently returns a transient
# 5xx on the final "complete upload" call *after* the binary is delivered, and
# re-runs can hit ITMS-90189 (redundant binary). Retry transient errors; treat
# an already-present build as success so re-runs are idempotent. Mirrors the
# proven wrapper from the Kiroku app.
def upload_to_testflight_with_retry(api_key_path, changelog: nil)
  params = {
    api_key_path: api_key_path,
    distribute_external: false,
    skip_waiting_for_build_processing: true,
    ipa: IPA_NAME,
  }
  # Only set changelog when present, so `beta` stays byte-for-byte identical.
  params[:changelog] = changelog unless changelog.nil? || changelog.empty?

  attempts = 0
  max_attempts = 3
  begin
    attempts += 1
    upload_to_testflight(params)
  rescue => e
    message = e.message.to_s
    if message.match?(/already been used|already exists|already been uploaded|redundant binary/i)
      UI.important("Build already present on App Store Connect; treating the TestFlight upload as successful (#{message.strip})")
    elsif attempts < max_attempts && message.match?(%r{status code 5\d\d|internal server error|CHANGE UPLOAD STATE TO COMPLETE|Could not download/upload|Error uploading ipa|timed out|connection reset}i)
      UI.error("TestFlight upload attempt #{attempts}/#{max_attempts} failed: #{message.strip}")
      UI.important("Retrying in 30s after a transient App Store Connect error...")
      sleep(30)
      retry
    else
      raise
    end
  end
end

# App Review contact + demo account. The non-secret half lives in the metadata
# tree; the demo credentials and the contact phone number deliberately do not,
# so they can't be committed by accident. They come from the environment and are
# read straight into the request without being logged.
def app_review_information_from(metadata_dir)
  read = lambda do |name|
    path = File.join(metadata_dir, "review_information", "#{name}.txt")
    UI.user_error!("Missing #{path}") unless File.exist?(path)
    # Read as UTF-8 explicitly: notes.txt contains Japanese, and Ruby otherwise
    # picks the locale's external encoding, which is US-ASCII on a CI runner and
    # blows up on the first multibyte character.
    File.read(path, encoding: "UTF-8").strip
  end

  fetch_secret = lambda do |var, hint|
    value = ENV[var].to_s.strip
    UI.user_error!("#{var} is not set. #{hint}") if value.empty?
    value
  end

  {
    first_name: read.call("first_name"),
    last_name: read.call("last_name"),
    email_address: read.call("email_address"),
    notes: read.call("notes"),
    phone_number: fetch_secret.call("REVIEW_PHONE", "A contact number App Review can call."),
    demo_user: fetch_secret.call("DEMO_USER", "The seeded demo account's email."),
    demo_password: fetch_secret.call("DEMO_PASSWORD", "The seeded demo account's password."),
  }
end

default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight (internal)"
  lane :beta do
    build_and_upload
  end

  desc "Build a PR preview and upload to TestFlight (internal), tagged via PREVIEW_CHANGELOG"
  lane :preview do
    build_and_upload(changelog: ENV["PREVIEW_CHANGELOG"])
  end

  # Uploads store text and screenshots only. Deliberately separate from `beta`
  # and `preview`, which touch TestFlight and never the public listing: keep it
  # that way, and keep this lane out of the deploy workflow. Run it by hand.
  #
  #   ASC_API_KEY_PATH=... DEMO_USER=... DEMO_PASSWORD=... REVIEW_PHONE=... \
  #     bundle exec fastlane metadata
  #
  # It does NOT submit for review: it fills the version in App Store Connect and
  # leaves the Submit button to a human.
  desc "Upload App Store metadata and screenshots (no binary, no submission)"
  lane :metadata do
    metadata_dir = File.expand_path("metadata", __dir__)
    screenshots_dir = File.expand_path("screenshots", __dir__)

    unless Dir.glob(File.join(screenshots_dir, "*", "*.png")).any?
      UI.user_error!("No screenshots in #{screenshots_dir}. See docs/app-store-screenshots.md.")
    end

    # Resolve everything local before the first network call, so a missing
    # variable fails in a second rather than after an authentication round trip.
    review_info = app_review_information_from(metadata_dir)
    api_key_path = ENV["ASC_API_KEY_PATH"].to_s.strip
    UI.user_error!("ASC_API_KEY_PATH is not set. Point it at the App Store Connect API key JSON.") if api_key_path.empty?
    UI.user_error!("ASC_API_KEY_PATH is set but #{api_key_path} does not exist.") unless File.exist?(api_key_path)

    deliver(
      api_key_path: api_key_path,
      app_identifier: APP_ID,
      metadata_path: metadata_dir,
      screenshots_path: screenshots_dir,
      app_review_information: review_info,

      skip_binary_upload: true,
      skip_app_version_update: false,

      # Replace the existing set rather than appending to it, so a re-run after a
      # re-capture doesn't leave stale frames behind.
      overwrite_screenshots: true,

      # Never submit from here. Review is a decision, not a side effect.
      submit_for_review: false,

      # No HTML preview prompt: this is run non-interactively as often as not.
      force: true,
      precheck_include_in_app_purchases: false,
    )
  end
end
