{
	"name": "kyuhachi",
	"private": true,
	"workspaces": [
		"app",
		"shared"
	],
	"dependencies": {
		"react-native-worklets": "0.7.2"
	},
	"scripts": {
		"build:legal": "node scripts/build-legal-html.mjs",
		"check:metadata": "node scripts/check-metadata-lengths.mjs",
		"deploy:functions": "firebase deploy --only functions",
		"deploy:hosting": "firebase deploy --only hosting",
		"journey:import-gpx": "NODE_PATH=functions/node_modules npx ts-node --transpile-only --project functions/tsconfig.json scripts/import-journey-gpx.ts",
		"seed:demo": "NODE_PATH=functions/node_modules npx ts-node --transpile-only --project functions/tsconfig.json scripts/seed-demo-account.ts",
		"version:bump": "node scripts/version.mjs"
	},
	"devDependencies": {
		"@types/react": "~19.2.2",
		"typescript": "~5.9.2"
	}
}
