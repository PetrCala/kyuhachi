rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // The public journey website (website/) reads Petr's own journey as an
    // UNAUTHENTICATED client: his challenges, visits and routes, plus the
    // catalog collections it renders them against. He has agreed to make his
    // journey fully public; only this one uid is exposed, and his user
    // document (it carries his email) stays private. If this uid ever has to
    // change, change it here and in firebase/test/firestore.rules.test.ts.
    function isJourneyUser(userId) {
      return userId == 'juEfBPJSspS9E2dqMzRac07C1Gs1';
    }

    // Onsen catalog: public read (the journey website renders it without
    // signing in; the catalog holds nothing private).
    // Writes go through the data repo service account, never the app
    match /onsens/{kyuhachiId} {
      allow read: if true;
      allow write: if false;
    }

    // Catalog metadata: read-only for any authenticated user
    match /catalog_meta/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Challenge type definitions: public read (the journey website derives
    // the eligible pool from them without signing in)
    match /challenge_types/{typeId} {
      allow read: if true;
      allow write: if false;
    }

    // Walked-day GPS tracks for the public journey website, one doc per day
    // (id = YYYY-MM-DD). Written exclusively with admin credentials (the
    // scheduled Strava sync Function or the manual GPX import), which bypass
    // these rules, so every client write is denied, including Petr's own.
    match /journey_days/{date} {
      allow read: if true;
      allow write: if false;
    }

    // Area guides (tourist info per region): read-only for any authenticated user.
    // Writes go through the data repo service account, never the app.
    match /area_guides/{areaId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Area-guides metadata (publish version): read-only for any authenticated user.
    match /area_guides_meta/{docId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // User documents and all subcollections: owner only, with one deliberate
    // exception: the journey uid's challenges, visits and routes are publicly
    // readable (see isJourneyUser above). The user DOCUMENT itself is public
    // for no one; it carries the email address.
    //
    // The blanket write on the user document itself is deliberate and was
    // re-audited for the public release. The document carries displayName,
    // email, defaultChallengeId and createdAt, and none of them is trusted:
    // displayName/email are denormalized copies of the Auth record that nothing
    // reads back (the account screen reads the Auth user), defaultChallengeId
    // only picks which of the owner's own challenges the owner sees, no rule
    // here does a get() on this path, and no Function reads a field off it.
    // There is no role, admin flag, entitlement, tier or denormalized count, so
    // forging any of it gains the forger nothing.
    //
    // The day a field lands here that a Function, a rule, or another user's
    // view has to trust (a role, an entitlement, a denormalized count), that
    // stops being true: guard the field the way earnedTier is guarded below,
    // and update the "no field on the user document is server-only" test.
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // earnedTier (the claimed tier) and earnedTierAt (when it was claimed) are
      // server-only, written exclusively by the claimTier callable (admin
      // credentials bypass rules). The client may create them as null and may
      // never change them, so a tier can't be forged.
      //
      // immutableOnUpdate() additionally freezes the fields a challenge is
      // defined by. Two reasons:
      //
      //   1. ADR 003 says a challenge's snapshot is frozen at creation, and
      //      until now nothing enforced it: the invariant lived only in the
      //      client's write paths.
      //   2. claimTier re-derives eligibility from snapshotEligibleOnsenIds,
      //      typeId and startDate (functions/src/util/tier.ts). Leaving them
      //      writable meant the "server-only" tier was still computed from
      //      client-controlled inputs, so guarding earnedTier alone bought less
      //      than it looked like it did.
      //
      // completedAt is here for the same reason: the visit triggers own it, and
      // they write with admin credentials, which bypass these rules.
      //
      // diff() reports only keys whose value actually changed, so a full
      // document overwrite that preserves these fields still passes; only a real
      // change is rejected. The app never updates any of them after creation:
      // it writes name, isDefault, activeRouteId and updatedAt (see
      // challenge/list.tsx, routes/index.tsx, useActiveChallengeProgress.ts).
      match /challenges/{challengeId} {
        function immutableOnUpdate() {
          return [
            'earnedTier', 'earnedTierAt', 'completedAt',
            'typeId', 'snapshotEligibleOnsenIds', 'snapshotCatalogVersion',
            'startDate', 'createdAt'
          ];
        }

        // Public read for the journey uid: the website finds the default
        // challenge (isDefault == true) and its activeRouteId. Deletes and
        // writes stay owner-only.
        allow read: if isOwner(userId) || isJourneyUser(userId);
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId)
          && (!('earnedTier' in request.resource.data) || request.resource.data.earnedTier == null)
          && (!('earnedTierAt' in request.resource.data) || request.resource.data.earnedTierAt == null);
        allow update: if isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(immutableOnUpdate());

        match /visits/{onsenId} {
          // Public read for the journey uid: photos, ratings and notes are
          // the heart of the journey website. Petr publishes them knowingly.
          allow read: if isOwner(userId) || isJourneyUser(userId);
          allow write: if isOwner(userId);
        }
      }

      match /routes/{routeId} {
        // Public read for the journey uid: the website draws the planned
        // route (the challenge's activeRouteId) from here.
        allow read: if isOwner(userId) || isJourneyUser(userId);
        allow write: if isOwner(userId);
      }

      match /favorites/{onsenId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
